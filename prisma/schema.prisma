generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id String @id @default("default")

  name     String
  nameFa   String
  tagline  String
  email    String
  location String

  heroTitleLine1    String
  heroTitleHighlight String
  heroDescription   String
  heroStat1Label    String
  heroStat1Value    String
  heroStat2Label    String
  heroStat2Value    String
  heroStat3Label    String
  heroStat3Value    String
  heroCtaPrimary    String
  heroCtaSecondary  String

  aboutEyebrow      String
  aboutTitle        String
  aboutParagraph1   String
  aboutParagraph2   String

  approachEyebrow      String
  approachTitle        String
  approachDescription  String

  productsEyebrow      String
  productsTitle        String
  productsDescription  String

  teamEyebrow      String
  teamTitle        String
  teamDescription  String

  contactEyebrow      String
  contactTitle        String
  contactDescription  String
  contactSuccessTitle String
  contactSuccessText  String

  footerBlurb String

  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?

  brandColor  String @default("#2f7cc4")
  accentColor String @default("#c96b32")

  textColor          String @default("#1c232c")
  headingColor       String @default("#141a22")
  mutedColor         String @default("#3f4b58")
  hintColor          String @default("#5a6570")
  placeholderColor   String @default("#6b7682")
  textColorDark      String @default("#ede8e1")
  headingColorDark   String @default("#f5f1ea")
  mutedColorDark     String @default("#c9c2b8")
  hintColorDark      String @default("#b8b0a6")
  placeholderColorDark String @default("#a39b91")

  heroVisualMode String  @default("motion")
  heroVisualUrl  String?

  updatedAt DateTime @updatedAt
}

model NavItem {
  id        String @id @default(cuid())
  href      String
  label     String
  sortOrder Int    @default(0)
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  indexLabel  String
  name        String
  nameEn      String
  status      String
  title       String
  description String
  imageUrl    String?
  sortOrder   Int            @default(0)
  points      ProductPoint[]
}

model ProductPoint {
  id        String  @id @default(cuid())
  text      String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  bio       String
  initials  String
  imageUrl  String?
  sortOrder Int     @default(0)
}

model ValueItem {
  id        String @id @default(cuid())
  title     String
  text      String
  sortOrder Int    @default(0)
}

model ApproachStep {
  id         String @id @default(cuid())
  indexLabel String
  title      String
  text       String
  sortOrder  Int    @default(0)
}

model Keyword {
  id        String @id @default(cuid())
  word      String
  sortOrder Int    @default(0)
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  sortOrder   Int        @default(0)
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  excerpt       String         @default("")
  content       String         @default("")
  coverImageUrl String?
  status        String         @default("draft")
  publishedAt   DateTime?
  categoryId    String?
  category      BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          BlogPostTag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
