generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id String @id @default("default")

  name     String
  nameFa   String
  tagline  String
  email    String
  location String

  heroTitleLine1    String
  heroTitleHighlight String
  heroDescription   String
  heroStat1Label    String
  heroStat1Value    String
  heroStat2Label    String
  heroStat2Value    String
  heroStat3Label    String
  heroStat3Value    String
  heroCtaPrimary    String
  heroCtaSecondary  String

  aboutEyebrow      String
  aboutTitle        String
  aboutParagraph1   String
  aboutParagraph2   String

  approachEyebrow      String
  approachTitle        String
  approachDescription  String

  productsEyebrow      String
  productsTitle        String
  productsDescription  String

  teamEyebrow      String
  teamTitle        String
  teamDescription  String

  blogEyebrow     String @default("05 — بلاگ")
  blogTitle       String @default("آخرین نوشته‌ها")
  blogDescription String @default("یادداشت‌هایی دربارهٔ روان‌شناسی، محصول و ساخت نرم‌افزار در تقاطع انسان و فناوری.")
  blogCta         String @default("مشاهده همه مقالات")

  contactEyebrow      String
  contactTitle        String
  contactDescription  String
  contactSuccessTitle String
  contactSuccessText  String

  footerBlurb String

  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?

  brandColor  String @default("#2f7cc4")
  accentColor String @default("#c96b32")

  textColor          String @default("#1c232c")
  headingColor       String @default("#0f1419")
  mutedColor         String @default("#2f3a46")
  navColor           String @default("#2a3440")
  labelColor         String @default("#3a4552")
  hintColor          String @default("#4a5563")
  placeholderColor   String @default("#5c6775")
  eyebrowColor       String @default("#c96b32")
  textColorDark      String @default("#f0ebe4")
  headingColorDark   String @default("#faf7f2")
  mutedColorDark     String @default("#d2cbc2")
  navColorDark       String @default("#ddd6cd")
  labelColorDark     String @default("#cfc8bf")
  hintColorDark      String @default("#c4bdb4")
  placeholderColorDark String @default("#b5aea4")
  eyebrowColorDark   String @default("#e08a4a")

  heroVisualMode String  @default("motion")
  heroVisualUrl  String?

  // English content (empty falls back to the Persian value)
  taglineEn                  String @default("")
  locationEn                 String @default("")
  heroTitleLine1En           String @default("")
  heroTitleHighlightEn       String @default("")
  heroDescriptionEn          String @default("")
  heroStat1LabelEn           String @default("")
  heroStat1ValueEn           String @default("")
  heroStat2LabelEn           String @default("")
  heroStat2ValueEn           String @default("")
  heroStat3LabelEn           String @default("")
  heroStat3ValueEn           String @default("")
  heroCtaPrimaryEn           String @default("")
  heroCtaSecondaryEn         String @default("")
  aboutEyebrowEn             String @default("")
  aboutTitleEn               String @default("")
  aboutParagraph1En          String @default("")
  aboutParagraph2En          String @default("")
  approachEyebrowEn          String @default("")
  approachTitleEn            String @default("")
  approachDescriptionEn      String @default("")
  productsEyebrowEn          String @default("")
  productsTitleEn            String @default("")
  productsDescriptionEn      String @default("")
  teamEyebrowEn              String @default("")
  teamTitleEn                String @default("")
  teamDescriptionEn          String @default("")
  blogEyebrowEn              String @default("")
  blogTitleEn                String @default("")
  blogDescriptionEn          String @default("")
  blogCtaEn                  String @default("")
  contactEyebrowEn           String @default("")
  contactTitleEn             String @default("")
  contactDescriptionEn       String @default("")
  contactSuccessTitleEn      String @default("")
  contactSuccessTextEn       String @default("")
  footerBlurbEn              String @default("")

  updatedAt DateTime @updatedAt
}

model NavItem {
  id        String @id @default(cuid())
  href      String
  label     String
  labelEn   String @default("")
  sortOrder Int    @default(0)
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  indexLabel  String
  name        String
  nameEn      String
  status      String
  title       String
  description String
  indexLabelEn String @default("")
  statusEn     String @default("")
  titleEn      String @default("")
  descriptionEn String @default("")
  imageUrl    String?
  sortOrder   Int            @default(0)
  points      ProductPoint[]
}

model ProductPoint {
  id        String  @id @default(cuid())
  text      String
  textEn    String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  bio       String
  initials  String
  nameEn    String  @default("")
  roleEn    String  @default("")
  bioEn     String  @default("")
  initialsEn String @default("")
  imageUrl  String?
  sortOrder Int     @default(0)
}

model ValueItem {
  id        String @id @default(cuid())
  title     String
  text      String
  titleEn   String @default("")
  textEn    String @default("")
  sortOrder Int    @default(0)
}

model ApproachStep {
  id         String @id @default(cuid())
  indexLabel String
  title      String
  text       String
  indexLabelEn String @default("")
  titleEn    String @default("")
  textEn     String @default("")
  sortOrder  Int    @default(0)
}

model Keyword {
  id        String @id @default(cuid())
  word      String
  wordEn    String @default("")
  sortOrder Int    @default(0)
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  nameEn      String     @default("")
  slug        String     @unique
  description String     @default("")
  descriptionEn String   @default("")
  sortOrder   Int        @default(0)
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  nameEn    String        @default("")
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id            String         @id @default(cuid())
  title         String
  titleEn       String         @default("")
  slug          String         @unique
  excerpt       String         @default("")
  excerptEn     String         @default("")
  content       String         @default("")
  contentEn     String         @default("")
  coverImageUrl String?
  status        String         @default("draft")
  viewCount     Int            @default(0)
  publishedAt   DateTime?
  categoryId    String?
  category      BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          BlogPostTag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
